{
  "name": "thiel-plaedoyers",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-26",
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "VideoRoom"
      },
      {
        "name": "TEACHERS",
        "class_name": "TeacherDesk"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "VideoRoom"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "TeacherDesk"
      ]
    }
  ],
  "r2_buckets": [
    {
      "binding": "VIDEOS",
      "bucket_name": "thiel-plaedoyers-videos"
    }
  ],
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.sql"
      ],
      "fallthrough": true
    }
  ],
  "ratelimits": [
    {
      "name": "CREATE_LIMIT",
      "namespace_id": "112601",
      "simple": {
        "limit": 3,
        "period": 60
      }
    },
    {
      "name": "LOGIN_LIMIT",
      "namespace_id": "112602",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": false
  }
}
